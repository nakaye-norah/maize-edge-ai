{
  "model_version": "mobilenetv3small-leafcheck-v1",
  "classes": [
    "Blight",
    "Common_Rust",
    "Gray_Leaf_Spot",
    "Healthy"
  ],
  "input_size": 224,
  "output_layout": "[leaf_check_score, P(Blight), P(Common_Rust), P(Gray_Leaf_Spot), P(Healthy)]",
  "gate_threshold": 0.8,
  "min_disease_confidence": 0.5,
  "frame_interval_ms": 250,
  "smoothing_frames": 3
}